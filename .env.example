# Konfigurasi Lingkungan ArcReel Generator
# Salin file ini ke .env dan isi dengan nilai Anda
#
# Sebagian besar konfigurasi (API Key, pemilihan backend, limit rate, pemilihan model, dll.)
# telah dipindahkan ke halaman konfigurasi WebUI (/settings).
# Konfigurasikan melalui halaman tersebut setelah aplikasi dijalankan untuk pertama kali.
# File ini hanya menyimpan konfigurasi tingkat startup / infrastruktur.

# ============================================================
# Konfigurasi Autentikasi (Authentication)
# ============================================================
# Username login (Default: admin)
AUTH_USERNAME=admin
# Password login (Biarkan kosong agar sistem menghasilkan otomatis pada startup pertama dan menulisnya kembali ke file ini)
AUTH_PASSWORD=
# Kunci tanda tangan JWT (Biarkan kosong agar dibuat otomatis, namun token akan hangus setelah restart dan perlu login ulang)
AUTH_TOKEN_SECRET=

# ============================================================
# Konfigurasi Database (Database Configuration)
# ============================================================
# Secara default menggunakan SQLite (Pengembangan/Single-machine)
# SQLite:     sqlite+aiosqlite:///./projects/.arcreel.db
# PostgreSQL: postgresql+asyncpg://user:pass@host:5432/arcreel
# DATABASE_URL=sqlite+aiosqlite:///./projects/.arcreel.db

# ============================================================
# Konfigurasi Log (Logging)
# ============================================================
# Level log (Default: INFO, Pilihan: DEBUG, WARNING, ERROR)
# LOG_LEVEL=INFO

# ============================================================
# Penyedia Video (Video Provider)
# ============================================================
# DEFAULT_VIDEO_PROVIDER=gemini     # Penyedia video default global (gemini | seedance)

# ============================================================
# Konfigurasi Seedance (Volcengine)
# ============================================================
# ARK_API_KEY=                      # API key Volcengine
# FILE_SERVICE_BASE_URL=            # Alamat publik layanan file proyek (Dibutuhkan akses publik untuk unggah gambar Seedance)
