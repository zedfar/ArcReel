# Konfigurasi Lingkungan Deployment Default ArcReel (SQLite)
# Salin sebagai .env lalu isi dengan nilai Anda

# ============================================================
# Konfigurasi Autentikasi (Authentication)
# ============================================================
# Username login (Default: admin)
AUTH_USERNAME=admin
# Password login (Biarkan kosong agar sistem menghasilkan otomatis pada startup pertama dan menulisnya kembali ke file .env)
AUTH_PASSWORD=
# Kunci tanda tangan JWT (Biarkan kosong agar dibuat otomatis, namun token akan hangus setelah restart dan perlu login ulang)
AUTH_TOKEN_SECRET=

# ============================================================
# Konfigurasi Log (Logging)
# ============================================================
# Level log (Default: INFO, Pilihan: DEBUG, WARNING, ERROR)
# LOG_LEVEL=INFO
